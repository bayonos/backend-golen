HOST=0.0.0.0
PORT=8080

# Option A: Connection URL (parsed automatically)
# DATABASE_URL=mysql://user:password@db-host:3306/smartfarm_db

# Option B: Individual DB_* or MYSQL_* parameters
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartfarm_db
DB_USERNAME=root
DB_PASSWORD=root

# Set a strong persistent random secret in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800
PBKDF2_ITERATIONS=210000
LOGIN_MAX_ATTEMPTS=10
LOGIN_RATE_WINDOW_SEC=60
